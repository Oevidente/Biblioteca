rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(authorUid) {
      return isSignedIn() && request.auth.uid == authorUid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == "andreluiz1902@gmail.com" ||
          request.auth.token.email == "romansanacional2026@gmail.com"
        ))
      );
    }

    // Stories Collection
    match /stories/{storyId} {
      // Public read for stories so any visitor or user can browse the library
      allow read: if true;
      
      // Signed in users can create stories
      allow create: if isSignedIn();
      
      // Update & Delete allowed for story owner or admin
      allow update, delete: if isOwner(resource.data.authorUid) || isAdmin();

      // Story Pages Subcollection
      match /pages/{pageId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Comments Subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Users Collection & User Subcollections (e.g. progress history)
    match /users/{userId} {
      allow create, read, update, delete: if true;

      match /progress/{progressId} {
        allow read, write: if true;
      }

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Author Requests Collection
    match /authorRequests/{reqId} {
      allow read, write: if true;
    }
    
    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Collection Group rule for progress queries (used in Admin Analytics)
    match /{path=**}/progress/{progressId} {
      allow read, write: if true;
    }
  }
}
