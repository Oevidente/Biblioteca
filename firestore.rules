rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stories Collection
    match /stories/{storyId} {
      allow read, write: if true;

      // Story Pages Subcollection
      match /pages/{pageId} {
        allow read, write: if true;
      }

      // Comments Subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Users Collection & User Subcollections (e.g. progress history)
    match /users/{userId} {
      allow read, write: if true;

      match /progress/{progressId} {
        allow read, write: if true;
      }

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Author Requests Collection
    match /authorRequests/{reqId} {
      allow read, write: if true;
    }
    
    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Collection Group rule for progress queries (used in Admin Analytics)
    match /{path=**}/progress/{progressId} {
      allow read, write: if true;
    }
  }
}
